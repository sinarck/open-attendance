{
  "name": "open-attendance",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n convex,web -c blue,green \"vp exec convex dev\" \"next dev\"",
    "dev:convex": "vp exec convex dev",
    "dev:next": "next dev",
    "build": "next build",
    "build:vercel": "vp exec convex deploy --cmd-url-env-var-name NEXT_PUBLIC_CONVEX_URL --cmd 'next build'",
    "start": "next start",
    "type-check": "tsgo --noEmit",
    "prepare": "vp config"
  },
