{
  "name": "open-attendance",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n convex,web -c blue,green \"vp exec convex dev\" \"next dev\"",
    "dev:convex": "vp exec convex dev",
    "dev:next": "next dev",
    "build": "next build --webpack",
    "build:vercel": "if [ -n \"$CONVEX_DEPLOY_KEY\" ] || { [ -n \"$CONVEX_SELF_HOSTED_URL\" ] && [ -n \"$CONVEX_SELF_HOSTED_ADMIN_KEY\" ]; }; then vp exec convex deploy --cmd-url-env-var-name NEXT_PUBLIC_CONVEX_URL --cmd 'next build --webpack'; else NEXT_PUBLIC_CONVEX_URL=\"${NEXT_PUBLIC_CONVEX_URL:-https://placeholder.convex.cloud}\" NEXT_PUBLIC_CONVEX_SITE_URL=\"${NEXT_PUBLIC_CONVEX_SITE_URL:-https://placeholder.convex.site}\" next build --webpack; fi",
    "start": "next start",
    "type-check": "tsgo --noEmit",
    "prepare": "vp config"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@convex-dev/better-auth": "^0.12.2",
    "@date-fns/tz": "^1.5.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-table": "^8.21.3",
    "@types/papaparse": "^5.5.2",
    "@uidotdev/usehooks": "^2.4.1",
    "better-auth": "~1.6.14",
    "boring-avatars": "^2.0.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.40.0",
    "convex-helpers": "^0.1.118",
    "date-fns": "^4.4.0",
    "haversine-distance": "^1.2.4",
    "lucide-react": "^1.17.0",
    "next": "^16.2.7",
    "next-themes": "^0.4.6",
    "nuqs": "^2.8.9",
    "papaparse": "^5.5.3",
    "posthog-js": "^1.379.2",
    "posthog-node": "^5.35.14",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-dropzone": "^15.0.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@posthog/nextjs-config": "^1.9.47",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^24.12.4",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "7.0.0-dev.20260603.1",
    "@vitest/coverage-v8": "^4.1.8",
    "babel-plugin-react-compiler": "1.0.0",
    "concurrently": "^10.0.3",
    "convex-test": "^0.0.53",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite-plus": "latest",
    "vitest": "npm:@voidzero-dev/vite-plus-test@^0.1.24"
  },
  "packageManager": "pnpm@11.5.3+sha512.7ac1c919341c213a34dc0d02afb7143c5c26ac26ee8c4782deea821b8ac64d2134a081fd8941dae6e29bbb48f58dfc2b7fbceeccc07cb2f09d219d342a4969ed",
  "reactDoctor": {
    "ignore": {
      "rules": [
        "react-hooks-js/incompatible-library"
      ]
    }
