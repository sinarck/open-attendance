# Replace all values below before running the app locally

# Shared Better Auth secret used by Next.js and Convex.
BETTER_AUTH_SECRET=""

# Optional override for the Convex site origin used by the Next.js Better Auth
# bridge. If omitted, it is derived from NEXT_PUBLIC_CONVEX_URL by swapping
# *.convex.cloud to *.convex.site.
CONVEX_SITE_URL=""

# Public / client
NEXT_PUBLIC_CONVEX_URL=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
NEXT_PUBLIC_POSTHOG_API_HOST="/ingest" # Useful to set to some random value, as we have rewrites configured.

# Vercel injects VERCEL_URL, VERCEL_BRANCH_URL, and
# VERCEL_PROJECT_PRODUCTION_URL automatically in preview/production. The env
# preset reads those directly, and Better Auth trusted origins are derived from
# those exact hosts instead of hard-coded domains.
# They are not required for local development.

# Optional Next.js server-only PostHog sourcemap upload
POSTHOG_API_KEY=""
POSTHOG_PROJECT_ID=""
