# Replace all values below before running the app locally

# Shared app origin used by Next.js and Convex auth config.
SITE_URL="http://localhost:3000"

# Shared Better Auth secret used by Next.js and Convex.
BETTER_AUTH_SECRET=""

# Convex site origin used by the Next.js Better Auth bridge.
# This must be your *.convex.site URL, not *.convex.cloud.
CONVEX_SITE_URL=""

# Public / client
NEXT_PUBLIC_CONVEX_URL=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
NEXT_PUBLIC_POSTHOG_API_HOST="/ingest"

# Optional Next.js server-only PostHog sourcemap upload
POSTHOG_API_KEY=""
POSTHOG_PROJECT_ID=""
