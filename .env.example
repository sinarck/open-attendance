# Replace all values below before running the app locally.
#
# Better Auth runs on Convex. Keep runtime auth secrets such as
# `BETTER_AUTH_SECRET` and provider credentials in Convex env via
# `vp exec convex env set ...`; `.env.local` / `.env.example` are only for the
# values Next.js needs locally.

# Convex / Better Auth server env
BETTER_AUTH_SECRET=""
SITE_URL="http://localhost:3000"

# Optional static JWKS cache for faster Convex token validation.
# Bootstrap this after the `auth:getLatestJwks` helper is available on your
# deployment, then set the returned JSON in Convex env as `JWKS`.
JWKS=""

# Public / client env
NEXT_PUBLIC_CONVEX_URL=""
NEXT_PUBLIC_CONVEX_SITE_URL=""
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
NEXT_PUBLIC_POSTHOG_API_HOST="/ingest" # Useful to set to some random value, as we have rewrites configured.

# Optional Next.js server-only PostHog sourcemap upload
POSTHOG_API_KEY=""
POSTHOG_PROJECT_ID=""
